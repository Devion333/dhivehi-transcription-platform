GEMINI_API_KEY=

# PostgreSQL used by the backend auth/session foundation.
POSTGRES_DB=transcript_app
POSTGRES_USER=transcript
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgres://transcript:change-this-local-password@postgres:5432/transcript_app?sslmode=disable

# Cookie/session settings.
SESSION_COOKIE_NAME=transcript_session
SESSION_LIFETIME=12h
SESSION_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000

# Explicit first-admin bootstrap. Leave blank unless creating the first admin.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Audit retention for explicit backend maintenance cleanup only.
# Cleanup command: cd backend && go run ./cmd/audit-cleanup --dry-run
AUDIT_RETENTION_DAYS=365

# In-app notification retention for explicit backend maintenance cleanup only.
# Cleanup command: cd backend && go run ./cmd/notification-cleanup
NOTIFICATION_RETENTION_DAYS=90

# Worker heartbeat reporting through Redis.
EXPECTED_WORKERS=conversion,diarization,transcription,analysis
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_TTL_SECONDS=60
WORKER_INSTANCE_ID=
